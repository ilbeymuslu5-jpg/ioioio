{
  "name": "ioioio",
  "version": "0.1.0",
  "description": "Multiplayer top-down arena survival IO game with rogue-lite and RPG progression — TypeScript engine.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "npm run build && node tools/serve.js",
    "serve": "node tools/serve.js",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "game",
    "io",
    "canvas",
    "arena",
    "phaser-ready"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
