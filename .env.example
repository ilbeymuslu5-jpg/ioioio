# Supabase (Project Settings → API). .env.local dosyasına kopyalayıp doldurun.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Yalnızca sunucu tarafı (admin işlemleri, bildirim işleri). ASLA istemciye açmayın.
SUPABASE_SERVICE_ROLE_KEY=

# Sitenin açık adresi (SEO, e-posta bağlantıları)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (bildirim e-postaları) — 9. adımda kullanılacak
RESEND_API_KEY=
